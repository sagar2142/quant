# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# MASTER_PLAN §14.1 / §13.7: research credentials and trading credentials are
# separate values, and trading credentials live only on the VPS from M11.

# ── environment ──────────────────────────────────────────────────────────────
# dev | paper | live   — drives the status-bar badge (§12.9) and safety gates
NEUTRON_ENV=dev

# ── database ─────────────────────────────────────────────────────────────────
# Host port is 5433, not 5432: another project on this machine already owns
# 5432. Change both values together if you move it.
POSTGRES_USER=neutron
POSTGRES_PASSWORD=neutron
POSTGRES_DB=neutron
NEUTRON_PG_PORT=5433
NEUTRON_REDIS_PORT=6380
# 127.0.0.1, not "localhost": on Windows localhost resolves to ::1 first while
# Docker publishes IPv4 only, which makes connections hang instead of failing.
NEUTRON_DB_URL=postgresql+psycopg://neutron:neutron@127.0.0.1:5433/neutron

# ── data lake (Parquet root) ─────────────────────────────────────────────────
NEUTRON_LAKE_PATH=./lake

# ── US equities: Alpaca (free paper account + free IEX data) ─────────────────
# Paper keys only. These grant market data and paper order entry, no real money.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── market data: India (from M2) ─────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── console API (§13.7, §21) ─────────────────────────────────────────────────
# Empty: reads open on loopback, kill switch DISABLED.
# Set it (openssl rand -hex 32) to enable the kill switch and lock reads.
NEUTRON_API_TOKEN=

# ── live trading (M11+, VPS only, SOPS-encrypted; never on the laptop) ───────
# NEUTRON_LIVE_ENABLED must be an explicit "true" for any real order to leave
# the process. Default-off is deliberate.
NEUTRON_LIVE_ENABLED=false
